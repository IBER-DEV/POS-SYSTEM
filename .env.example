# Host-side port mappings for docker compose. Defaults match each service's
# standard port; override here only if something else on your machine is
# already using one of them (see README.md for how these were adjusted on
# this particular dev machine).
DB_PORT_EXPOSED=5432
REDIS_PORT_EXPOSED=6379
API_PORT=8000

# Only used by the optional `caddy` service (`docker compose --profile https
# up -d`) - local HTTPS for LAN access. See "HTTPS for LAN access" in
# README.md.
HTTPS_PORT=8443
